  "guideHeroTitle": {
    "message": "AgentLimb — let any AI terminal precisely control your browser"
  },
  "guideHeroDesc": {
    "message": "One Chrome extension + one prompt to turn Claude Code, Codex, or Cursor into a reliable browser operator. No coding, no cloud bills, cheaper the more you use it."
  },
  "guideWhatItIs": {
    "message": "What it is"
  },
  "guideWhatItIsBody": {
    "message": "AgentLimb is a Chrome extension paired with a local Bridge. It translates tool calls from your AI terminal into Chrome Debugger Protocol commands, letting the AI read the DOM, click, type, screenshot, and navigate — like a precise robotic arm. No screenshot-and-guess, no third-party cloud, and it reuses the accounts you're already logged into in your own Chrome."
  },
  "guideWhoItsFor": {
    "message": "Who it's for"
  },
  "guideWhoItsForBody": {
    "message": "Developers using Claude Code / Codex / Cursor for browser tasks; people who want AI to handle repetitive web work (scraping, form filling, SaaS operations) without writing scripts; users who found Browser Use or BrowseAI too complex or too expensive; teams that need AI to operate internal systems using logged-in sessions."
  },
  "guideQuickStart": {
    "message": "Get started in 3 steps"
  },
  "guideStep1Title": {
    "message": "Copy the prompt"
  },
  "guideStep1Desc": {
    "message": "Click the 📋 at the top or the \"Copy Prompt\" button on the idle screen — the prompt goes straight to your clipboard."
  },
  "guideStep2Title": {
    "message": "Paste it to your AI terminal"
  },
  "guideStep2Desc": {
    "message": "Open Claude Code / Codex / Cursor and paste the prompt in. The Bridge auto-starts in the background — no terminal commands needed."
  },
  "guideStep3Title": {
    "message": "Give the AI a task"
  },
  "guideStep3Desc": {
    "message": "Just describe what you want in natural language. The AI drives the browser through the extension, and the side panel shows live progress."
  },
  "guideMuscle": {
    "message": "Cheaper every time: muscle memory"
  },
  "guideMuscleBody": {
    "message": "On first visit, the AI explores and remembers: which button is where, how to fill the form, what gotchas to avoid. These notes are stored as JSON in ~/Desktop/AgentLimb-muscle/ and replayed on the next run — skipping exploration. Real tests show ~85% fewer tokens and minutes compressed to seconds for the same task."
  },
  "guideMultiProfile": {
    "message": "Run multiple browser profiles in parallel"
  },
  "guideMultiProfileBody": {
    "message": "Open a second (or third) Chrome profile on the same machine and the AI can drive them all at once. Each panel shows its own Profile-xxxxxx label at the top of the monitor tab. The status dot in the top-right has three states: 🟢 working / 🟡 suspended / 🔴 offline. Click Suspend next to the identity to temporarily stop one profile from accepting AI commands — Bridge skips it, the other profiles keep working (the very last active profile can't be suspended, so there's always someone on duty). Task lifecycle events (plan → step_done → complete) automatically fan out to every active profile, so each panel sees the full progress — not a torn-in-half view. All profiles share one desktop muscle library — site knowledge learned by any profile is instantly reusable by the others."
  },
  "guideSupportedTerminals": {
    "message": "Supported AI terminals"
  },
  "guideSupportedTerminalsBody": {
    "message": "Claude Code (Anthropic) · Codex (OpenAI) · Cursor · locally hosted Ollama / LM Studio — any AI terminal that supports tool calls. Same extension, swap AIs freely."
  },
  "guidePrivacy": {
    "message": "Data & privacy"
  },
  "guidePrivacyBody": {
    "message": "All data stays local. Muscle data lives in ~/Desktop/AgentLimb-muscle/ — you can inspect, back up, or move it at any time. No telemetry, no uploads, no third-party servers."
  },
  "guideTroubleshoot": {
    "message": "Troubleshooting"
  },
  "guideTroubleshootBody": {
    "message": "Bridge status red: open ⚙️ and re-copy the prompt into the AI terminal. AI not responding: confirm tool-calling is enabled on the terminal side. Actions not taking effect: click ⏻ to stop the Bridge, then re-paste the prompt to restart. More questions → GitHub Issues."
  },
