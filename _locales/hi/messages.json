  },
  "guideHeroTitle": {
    "message": "AgentLimb — किसी भी AI टर्मिनल से अपने ब्राउज़र को सटीकता से नियंत्रित करें"
  },
  "guideHeroDesc": {
    "message": "एक Chrome एक्सटेंशन + एक प्रॉम्प्ट Claude Code, Codex या Cursor को भरोसेमंद ब्राउज़र ऑपरेटर बना देते हैं। न कोडिंग, न क्लाउड बिल, जितना अधिक उपयोग उतना सस्ता।"
  },
  "guideWhatItIs": {
    "message": "यह क्या है?"
  },
  "guideWhatItIsBody": {
    "message": "AgentLimb एक Chrome एक्सटेंशन है जो एक लोकल Bridge के साथ जुड़ता है। यह आपके AI टर्मिनल के टूल कॉल को Chrome Debugger Protocol कमांड में अनुवाद करता है, जिससे AI DOM पढ़ सकता है, क्लिक, टाइप, स्क्रीनशॉट और नेविगेट कर सकता है — एक सटीक रोबोटिक आर्म की तरह। स्क्रीनशॉट से अनुमान नहीं, तीसरे पक्ष का क्लाउड नहीं, और यह आपके Chrome में पहले से लॉगिन खातों का सीधे उपयोग करता है।"
  },
  "guideWhoItsFor": {
    "message": "किसके लिए है"
  },
  "guideWhoItsForBody": {
    "message": "ब्राउज़र कार्यों के लिए Claude Code / Codex / Cursor उपयोग करने वाले डेवलपर; वे लोग जो AI से दोहराव वाले वेब कार्य (स्क्रैपिंग, फ़ॉर्म भरना, SaaS ऑपरेशन) बिना स्क्रिप्ट लिखे करवाना चाहते हैं; जिन्हें Browser Use या BrowseAI बहुत जटिल या महँगा लगा; वे टीमें जिन्हें AI को पहले से लॉगिन सत्रों के ज़रिए आंतरिक सिस्टम चलाने की ज़रूरत है।"
  },
  "guideQuickStart": {
    "message": "3 चरणों में शुरू करें"
  },
  "guideStep1Title": {
    "message": "प्रॉम्प्ट कॉपी करें"
  },
  "guideStep1Desc": {
    "message": "ऊपर 📋 या निष्क्रिय स्क्रीन पर «प्रॉम्प्ट कॉपी करें» पर क्लिक करें — प्रॉम्प्ट सीधे क्लिपबोर्ड पर चला जाएगा।"
  },
  "guideStep2Title": {
    "message": "AI टर्मिनल में पेस्ट करें"
  },
  "guideStep2Desc": {
    "message": "Claude Code / Codex / Cursor खोलें और प्रॉम्प्ट पेस्ट करें। Bridge पृष्ठभूमि में स्वचालित शुरू हो जाता है — कोई टर्मिनल कमांड नहीं चाहिए।"
  },
  "guideStep3Title": {
    "message": "AI को कार्य दें"
  },
  "guideStep3Desc": {
    "message": "आप क्या चाहते हैं प्राकृतिक भाषा में बताइए। AI एक्सटेंशन के ज़रिए ब्राउज़र चलाता है, और साइड पैनल लाइव प्रगति दिखाता है।"
  },
  "guideMuscle": {
    "message": "हर बार सस्ता: मसल मेमोरी"
  },
  "guideMuscleBody": {
    "message": "पहली बार आने पर AI खोज करता और याद रखता है: कौन-सा बटन कहाँ है, फ़ॉर्म कैसे भरें, कौन-से जाल से बचें। ये नोट्स ~/Desktop/AgentLimb-muscle/ में JSON के रूप में सहेजे जाते हैं और अगले रन पर सीधे चलाए जाते हैं — खोज छोड़कर। असली परीक्षण: समान कार्य के लिए ~85% कम टोकन और मिनटों को सेकंडों में बदलना।"
  },
  "guideMultiProfile": {
    "message": "कई ब्राउज़र प्रोफ़ाइल समानांतर में चलाएं"
  },
  "guideMultiProfileBody": {
    "message": "एक ही मशीन पर दूसरा (या तीसरा) Chrome प्रोफ़ाइल खोलें और AI सभी को एक साथ चला सकता है। प्रत्येक पैनल शीर्ष पर अपना Profile-xxxxxx लेबल दिखाता है। ऊपर दाईं ओर स्थिति बिंदु तीन अवस्थाएं दिखाता है: 🟢 काम कर रहा / 🟡 निलंबित / 🔴 ऑफ़लाइन। पहचान के बगल में निलंबित करें बटन पर क्लिक करें ताकि प्रोफ़ाइल अस्थायी रूप से AI कमांड स्वीकार करना बंद कर दे — Bridge इसे छोड़ देता है, अन्य प्रोफ़ाइल काम करते रहते हैं (सबसे आखिरी सक्रिय प्रोफ़ाइल को निलंबित नहीं किया जा सकता, इसलिए हमेशा कोई न कोई ड्यूटी पर रहता है)। कार्य जीवनचक्र घटनाएं (plan → step_done → complete) स्वचालित रूप से प्रत्येक सक्रिय प्रोफ़ाइल को वितरित की जाती हैं, इसलिए प्रत्येक पैनल पूरी प्रगति देखता है — आधा-अधूरा दृश्य नहीं। सभी प्रोफ़ाइल एक ही डेस्कटॉप मसल लाइब्रेरी साझा करते हैं — किसी भी प्रोफ़ाइल द्वारा सीखा गया साइट ज्ञान तुरंत अन्य के लिए पुन: प्रयोज्य है।"
  },
  "guideSupportedTerminals": {
    "message": "समर्थित AI टर्मिनल"
  },
  "guideSupportedTerminalsBody": {
    "message": "Claude Code (Anthropic) · Codex (OpenAI) · Cursor · स्थानीय Ollama / LM Studio — कोई भी AI टर्मिनल जो टूल कॉल का समर्थन करता हो। एक ही एक्सटेंशन, AI स्वतंत्र रूप से बदलें।"
  },
  "guidePrivacy": {
    "message": "डेटा और गोपनीयता"
  },
  "guidePrivacyBody": {
    "message": "सारा डेटा स्थानीय रहता है। मसल डेटा ~/Desktop/AgentLimb-muscle/ में रहता है — आप कभी भी देख, बैकअप या स्थानांतरित कर सकते हैं। कोई टेलीमेट्री नहीं, कोई अपलोड नहीं, कोई तीसरे पक्ष का सर्वर नहीं।"
  },
  "guideTroubleshoot": {
    "message": "समस्या निवारण"
  },
  "guideTroubleshootBody": {
    "message": "Bridge लाल: ⚙️ खोलें और प्रॉम्प्ट को AI टर्मिनल में फिर से कॉपी-पेस्ट करें। AI जवाब नहीं देता: टर्मिनल की ओर से टूल कॉल सक्षम है की पुष्टि करें। क्रियाएँ काम नहीं करतीं: Bridge बंद करने के लिए ⏻ पर क्लिक करें, फिर पुनः आरंभ के लिए प्रॉम्प्ट पेस्ट करें। और प्रश्न → GitHub Issues।"
  },
  "aboutTagline": {
    "message": "किसी भी AI टर्मिनल से अपने ब्राउज़र को सटीकता से नियंत्रित करें — न कोड, न क्लाउड शुल्क, जितना अधिक उपयोग उतना सस्ता।"
  },
