  "aboutTitle": {
    "message": "AgentLimb - Informazioni"
  },
  "aboutDesc": {
    "message": "AgentLimb è un'estensione universale per l'automazione del browser che consente all'IA terminale (Claude Code, Cursor, Codex, ecc.) di controllare Chrome tramite strumenti MCP, trasformando l'IA nel tuo \"braccio meccanico\"."
  },
  "featureAI": {
    "message": "L'IA esplora la struttura della pagina e identifica automaticamente gli elementi interattivi"
  },
  "featureSkills": {
    "message": "Memoria muscolare: salva dopo l'esplorazione, riproduzione senza token la volta successiva"
  },
  "featureSchedule": {
    "message": "Attività pianificate: il browser funziona automaticamente anche quando l'IA è offline"
  },
  "featureMCP": {
    "message": "Qualsiasi strumento IA che supporta MCP o HTTP può connettersi"
  },
