{
  "manifest_version": 3,
  "name": "AgentLimb",
  "version": "0.5.7",
  "version_name": "0.5.7-l8",
  "description": "Let any MCP AI agent control your browser. Pair once, then the agent drives its own tabs — the side panel is only a chat window. 100% local.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "debugger",
    "tabGroups",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "kernel/control/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "AgentLimb",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-side-panel": {
      "description": "Toggle AgentLimb side panel",
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "kernel/control/content/a11y-tree.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "js": [
        "kernel/control/content/indicator.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
  }
}
