{
  "manifest_version": 3,
  "name": "AgentLimb",
  "version": "0.2.1",
  "description": "Let your terminal AI control your browser. Muscle memory cuts repeat-task tokens by 85%. 100% local — no cloud, no tracking.",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "debugger",
    "nativeMessaging",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "kernel/control/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/sidepanel/sidepanel.html"
  },
  "options_page": "ui/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AgentLimb",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg",
        "_locales/*/messages.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
