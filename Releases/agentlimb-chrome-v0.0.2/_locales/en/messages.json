  "guideTitle": {
    "message": "User Guide"
  },
  "guideWhatIsMuscle": {
    "message": "What is Muscle Memory?"
  },
  "guideWhatIsMuscleBody": {
    "message": "Muscle Memory is AgentLimb's core token-saving mechanism. When AI completes an operation on a platform for the first time (e.g. posting), AgentLimb automatically saves the action sequence as a \"muscle\". Next time, just replay the muscle — no AI exploration needed."
  },
  "guideSaveToken": {
    "message": "Token Savings — Real Test Data"
  },
  "guideSaveTokenBody": {
    "message": "Two real-world comparisons, clear conclusion:"
  },
  "guideExploreLabel": {
    "message": "First exploration"
  },
  "guideExploreValue": {
    "message": "~30 API calls, ~5000 tokens"
  },
  "guideMuscleLabel": {
    "message": "Muscle replay"
  },
  "guideMuscleValue": {
    "message": "1 call, ~300 tokens, 0 errors"
  },
  "guideSavings": {
    "message": "~16x efficiency boost"
  },
  "guideSaveTokenTip": {
    "message": "Each platform only needs one exploration, one save — then permanent reuse. The more you operate a platform, the more you save."
  },
  "guideWorkflow": {
    "message": "Recommended Workflow"
  },
  "guideWorkflowBody": {
    "message": "1. Plan with AI first — organize goals, platform list, content templates in project folder\n2. Set work project — select local folder, AI can read/write planning docs long-term\n3. AI explores first time — use observe + act on target platform\n4. Save as muscle — AI calls muscle(action:\"save\") to persist action sequence\n5. One-click reuse — muscle(action:\"run\") replays with zero token cost\n6. Schedule/batch — muscles can be scheduled for fully automatic execution"
  },
  "guideConnect": {
    "message": "How to Connect AI"
  },
  "guideConnectBody": {
    "message": "1. Click the \"Copy Onboard Prompt\" button on the home page\n2. Paste it to your terminal AI (Claude Code / Cursor / Codex, etc.)\n3. AI will auto-detect tools and start driving the browser\n\nTip: Set a \"Work Project\" folder so AI can read/write your planning docs for long-term collaboration across sessions."
  },
