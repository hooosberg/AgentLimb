  "aboutTitle": {
    "message": "AgentLimb - Sobre"
  },
  "aboutDesc": {
    "message": "AgentLimb é uma extensão universal de automação de navegador que permite que a IA de terminal (Claude Code, Cursor, Codex, etc.) controle o Chrome via ferramentas MCP, transformando a IA em seu \"braço mecânico\"."
  },
  "featureAI": {
    "message": "IA explora a estrutura da página e identifica automaticamente elementos interativos"
  },
  "featureSkills": {
    "message": "Memória muscular: salva após exploração, reprodução sem tokens na próxima vez"
  },
  "featureSchedule": {
    "message": "Tarefas agendadas: navegador executa automaticamente mesmo com IA offline"
  },
  "featureMCP": {
    "message": "Qualquer ferramenta de IA com suporte a MCP ou HTTP pode se conectar"
  },
