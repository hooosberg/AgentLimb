  "aboutTitle": {
    "message": "AgentLimb - À propos"
  },
  "aboutDesc": {
    "message": "AgentLimb est une extension universelle d'automatisation du navigateur qui permet à l'IA terminale (Claude Code, Cursor, Codex, etc.) de contrôler Chrome via des outils MCP, transformant l'IA en votre \"bras mécanique\"."
  },
