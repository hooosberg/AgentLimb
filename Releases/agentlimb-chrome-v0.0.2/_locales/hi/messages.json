  "guideTitle": {
    "message": "उपयोगकर्ता गाइड"
  },
  "guideWhatIsMuscle": {
    "message": "मसल मेमोरी क्या है?"
  },
  "guideWhatIsMuscleBody": {
    "message": "मसल मेमोरी AgentLimb का मुख्य टोकन-बचत तंत्र है। जब AI किसी प्लेटफ़ॉर्म पर पहली बार कोई ऑपरेशन पूरा करता है (जैसे पोस्ट करना), AgentLimb स्वतः क्रिया अनुक्रम को \"मसल\" के रूप में सहेजता है। अगली बार, बस मसल रीप्ले करें — AI पुनः अन्वेषण की आवश्यकता नहीं।"
  },
  "guideSaveToken": {
    "message": "टोकन बचत — वास्तविक परीक्षण डेटा"
  },
  "guideSaveTokenBody": {
    "message": "दो वास्तविक तुलनाएँ, स्पष्ट निष्कर्ष:"
  },
  "guideExploreLabel": {
    "message": "पहला अन्वेषण"
  },
  "guideExploreValue": {
    "message": "~30 API कॉल, ~5000 टोकन"
  },
  "guideMuscleLabel": {
    "message": "मसल रीप्ले"
  },
  "guideMuscleValue": {
    "message": "1 कॉल, ~300 टोकन, 0 त्रुटियाँ"
  },
  "guideSavings": {
    "message": "~16 गुना दक्षता वृद्धि"
  },
  "guideSaveTokenTip": {
    "message": "प्रत्येक प्लेटफ़ॉर्म को केवल एक अन्वेषण, एक सेव चाहिए — फिर स्थायी पुन: उपयोग। जितना अधिक आप किसी प्लेटफ़ॉर्म पर काम करें, उतनी अधिक बचत।"
  },
  "guideWorkflow": {
    "message": "अनुशंसित कार्यप्रवाह"
  },
  "guideWorkflowBody": {
    "message": "1. पहले AI के साथ योजना बनाएँ — प्रोजेक्ट फ़ोल्डर में लक्ष्य, प्लेटफ़ॉर्म सूची, सामग्री टेम्पलेट व्यवस्थित करें\n2. कार्य प्रोजेक्ट सेट करें — स्थानीय फ़ोल्डर चुनें, AI दीर्घकालिक योजना दस्तावेज़ पढ़/लिख सकता है\n3. AI पहली बार अन्वेषण — लक्ष्य प्लेटफ़ॉर्म पर observe + act उपयोग करें\n4. मसल के रूप में सहेजें — AI muscle(action:\"save\") कॉल करके क्रिया अनुक्रम सहेजता है\n5. एक-क्लिक पुन: उपयोग — muscle(action:\"run\") शून्य टोकन लागत से रीप्ले करता है\n6. शेड्यूल/बैच — मसल्स को पूर्ण स्वचालित निष्पादन के लिए शेड्यूल किया जा सकता है"
  },
  "guideConnect": {
    "message": "AI कैसे कनेक्ट करें"
  },
  "guideConnectBody": {
    "message": "1. होम पेज पर \"ऑनबोर्ड प्रॉम्प्ट कॉपी करें\" बटन क्लिक करें\n2. अपने टर्मिनल AI (Claude Code / Cursor / Codex, आदि) में पेस्ट करें\n3. AI स्वतः टूल्स पहचानेगा और ब्राउज़र नियंत्रित करना शुरू करेगा\n\nसुझाव: \"कार्य प्रोजेक्ट\" फ़ोल्डर सेट करें ताकि AI सत्रों के बीच दीर्घकालिक सहयोग के लिए आपके योजना दस्तावेज़ पढ़/लिख सके।"
  },
