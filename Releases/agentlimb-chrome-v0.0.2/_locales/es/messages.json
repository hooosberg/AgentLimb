  "aboutTitle": {
    "message": "AgentLimb - Acerca de"
  },
  "aboutDesc": {
    "message": "AgentLimb es una extensión universal de automatización del navegador que permite a la IA de terminal (Claude Code, Cursor, Codex, etc.) controlar Chrome mediante herramientas MCP, convirtiendo la IA en tu \"brazo mecánico\"."
  },
  "featureAI": {
    "message": "La IA explora la estructura de la página e identifica automáticamente elementos interactivos"
  },
  "featureSkills": {
    "message": "Memoria muscular: guarda tras explorar, reproduce sin tokens la próxima vez"
  },
  "featureSchedule": {
    "message": "Tareas programadas: el navegador se ejecuta automáticamente incluso con la IA desconectada"
  },
  "featureMCP": {
    "message": "Cualquier herramienta de IA compatible con MCP o HTTP puede conectarse"
  },
