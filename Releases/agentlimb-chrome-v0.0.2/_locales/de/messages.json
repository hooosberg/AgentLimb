  "aboutTitle": {
    "message": "AgentLimb - Über"
  },
  "aboutDesc": {
    "message": "AgentLimb ist eine universelle Browser-Automatisierungserweiterung, die Terminal-KI (Claude Code, Cursor, Codex, etc.) Chrome über MCP-Tools steuern lässt und KI in Ihren \"mechanischen Arm\" verwandelt."
  },
  "featureAI": {
    "message": "KI erkundet Seitenstruktur und identifiziert automatisch interaktive Elemente"
  },
  "featureSkills": {
    "message": "Muskelgedächtnis: Nach Erkundung speichern, nächstes Mal ohne Tokens abspielen"
  },
  "featureSchedule": {
    "message": "Geplante Aufgaben: Browser läuft automatisch, auch wenn KI offline ist"
  },
  "featureMCP": {
    "message": "Jedes KI-Tool mit MCP- oder HTTP-Unterstützung kann sich verbinden"
  },
